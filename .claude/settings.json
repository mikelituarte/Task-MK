{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env*)",
      "Read(**/*.env)",
      "Read(./infrastructure/.env)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(**/.env*)",
      "Edit(**/*.env)",
      "Edit(./infrastructure/.env)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",

      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.mcp.json)",

      "Bash(gh secret)",
      "Bash(gh secret *)",
      "Bash(ssh)",
      "Bash(ssh *)",
      "Bash(make prod-deploy*)",
      "Bash(make * prod-deploy*)",
      "Bash(make restore*)",
      "Bash(make * restore*)",
      "Bash(make reset-db*)",
      "Bash(make * reset-db*)",
      "Bash(make admin-*)",
      "Bash(make * admin-*)"
    ]
  }
}
