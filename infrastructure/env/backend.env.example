# Variables del servicio backend (plan-backend 8.11). Todas son obligatorias.
# NODE_ENV, COOKIE_SECURE y TRUST_PROXY NO van aquí: las fija `environment:`
# del override de Compose, que prevalece sobre este fichero (S-03).
# El backend rechaza cualquier secreto que contenga CHANGE_ME y cualquier
# variable BACKUP_* o MONGO_INITDB_*.
# Genera el fichero real con infrastructure/scripts/env-init.

# Puerto en el que escucha el backend dentro de la red de Compose.
PORT=3000
# URI de MongoDB con el usuario `app` (secreto: la contraseña es la de MONGO_APP_PASSWORD).
MONGODB_URI=mongodb://app:CHANGE_ME@mongodb:27017/taskmk
# Secreto de firma del access token (secreto, >= 32 bytes).
JWT_ACCESS_SECRET=CHANGE_ME
# Vida del access token.
JWT_ACCESS_TTL=15m
# Vida de cada refresh token.
REFRESH_TTL=7d
# Vida máxima de una familia de refresh tokens.
REFRESH_FAMILY_TTL=30d
# Margen en segundos para reusar un refresh token recién rotado.
REFRESH_GRACE_SECONDS=30
# Secreto del token CSRF (secreto, >= 32 bytes).
CSRF_SECRET=CHANGE_ME
# Clave HMAC con la que se derivan las claves del límite de intentos de login (secreto, >= 32 bytes).
LOGIN_THROTTLE_SECRET=CHANGE_ME
# URL pública de la aplicación: base de los enlaces y origen esperado. En E2E la fija el override.
APP_URL=http://localhost:5173
# Nivel de log de pino.
LOG_LEVEL=info
