# Variables del servicio mongodb. Solo se usan al inicializar un volumen vacío.
# Cada contraseña se repite en otro fichero y debe coincidir:
#   MONGO_APP_PASSWORD     -> MONGODB_URI de backend.env
#   MONGO_MIGRATE_PASSWORD -> MONGODB_URI de migrate.env
#   MONGO_BACKUP_PASSWORD  -> MONGO_BACKUP_PASSWORD de backup.env
# Genera el fichero real con infrastructure/scripts/env-init.

# Usuario root de MongoDB (solo para administración y restauración).
MONGO_INITDB_ROOT_USERNAME=root
# Contraseña del usuario root (secreto).
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
# Base de datos de la aplicación, donde se crean `app` y `migrate`.
MONGO_INITDB_DATABASE=taskmk
# Usuario de la aplicación (lectura y escritura de datos en taskmk).
MONGO_APP_USER=app
# Contraseña del usuario de la aplicación (secreto).
MONGO_APP_PASSWORD=CHANGE_ME
# Usuario de las migraciones (índices y colecciones en taskmk).
MONGO_MIGRATE_USER=migrate
# Contraseña del usuario de las migraciones (secreto).
MONGO_MIGRATE_PASSWORD=CHANGE_ME
# Usuario de los backups, creado en la base admin.
MONGO_BACKUP_USER=backup
# Contraseña del usuario de los backups (secreto).
MONGO_BACKUP_PASSWORD=CHANGE_ME
