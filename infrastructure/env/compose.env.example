# Variables de interpolación de Docker Compose (infrastructure/.env, S-04).
# Nada de este fichero es secreto, pero en producción tampoco se versiona.
# Genera el fichero real con infrastructure/scripts/env-init.

# Directorio de los ficheros de entorno: ./env (dev), ./env/e2e (E2E), /etc/taskmk (prod).
ENV_DIR=./env
# Dominio público que sirve Caddy. En desarrollo no se usa.
DOMAIN=localhost
# Email de la cuenta ACME de Caddy. En desarrollo y E2E es de relleno.
ACME_EMAIL=admin@example.com
# Etiqueta de las imágenes propias en GHCR (en producción, el SHA desplegado).
IMAGE_TAG=dev
# Propietario de las imágenes en GHCR, en minúsculas.
GHCR_OWNER=example
