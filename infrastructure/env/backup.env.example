# Variables de backup.sh, que corre en el host. Nunca llegan al backend.
# En desarrollo no se usan age ni S3 (S-08): los valores son de relleno.
# Genera el fichero real con infrastructure/scripts/env-init.

# Usuario de MongoDB para mongodump (debe coincidir con mongodb.env).
MONGO_BACKUP_USER=backup
# Contraseña del usuario de backups (secreto; debe coincidir con mongodb.env).
MONGO_BACKUP_PASSWORD=CHANGE_ME
# Clave pública age con la que se cifra cada backup (no es secreta).
BACKUP_AGE_RECIPIENT=<AGE_RECIPIENT>
# Endpoint S3 del proveedor de almacenamiento.
BACKUP_S3_ENDPOINT=https://s3.example.com
# Bucket de los backups.
BACKUP_S3_BUCKET=taskmk-backups-example
# Identificador de la credencial S3 de solo escritura (secreto).
BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME
# Clave de la credencial S3 de solo escritura (secreto).
BACKUP_S3_SECRET_ACCESS_KEY=CHANGE_ME
