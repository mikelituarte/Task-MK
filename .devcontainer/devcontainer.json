// Devcontainer de los agentes (plan-infrastructure, fase 2). Ver docs/infrastructure/devcontainer.md.
{
  "name": "Task-MK (agentes)",
  "dockerComposeFile": ["compose.yaml"],
  "service": "workspace",
  "runServices": ["workspace", "egress"],
  "workspaceFolder": "/workspaces/Task-MK",
  "shutdownAction": "stopCompose",
  "remoteUser": "node",

  // Docker propio con Compose v2 (docker-in-docker). Nunca el socket del host.
  // Feature `docker-in-docker:2` y Docker 29.9.3 fijados el 2026-11-12, tras verificar el devcontainer.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker@sha256:25b9f05705ffba7dbe503230ac76081419306f8c8bc88e0ce78c4ecd99a0c78c": {
      "version": "29.9.3",
      "moby": false,
      "dockerDashComposeVersion": "v2",
      "installDockerBuildx": true
    }
  },

  "remoteEnv": {
    // Token de instalación de la GitHub App (1 h, limitado a Task-MK), emitido fuera del
    // devcontainer (S-24). La clave privada de la App nunca entra.
    "GH_TOKEN": "${localEnv:TASKMK_AGENT_GH_TOKEN}",
    // Sin agente SSH reenviado desde el host.
    "SSH_AUTH_SOCK": ""
  },

  // Comprueba aislamiento y salida en cada arranque. Solo avisa: no bloquea el arranque.
  "postStartCommand": "taskmk-verify-isolation || echo 'AVISO: el devcontainer NO está aislado; no lances agentes.' >&2",

  "customizations": {
    "vscode": {
      "settings": {
        "dev.containers.copyGitConfig": false,
        "dev.containers.gitCredentialHelperConfigLocation": "none",
        "dev.containers.dockerCredentialHelper": false,
        "remote.SSH.enableAgentForwarding": false
      }
    }
  }
}
